{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flick.invalid/schema/validation-result-v1.json",
  "title": "FlickNet validation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_status",
    "scope",
    "task",
    "kind",
    "result",
    "started_at",
    "finished_at",
    "duration_ms",
    "source",
    "environment",
    "build",
    "commands",
    "inputs",
    "input_hashes",
    "artifacts",
    "counts",
    "reference_analysis",
    "defects",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "flick.validation-result/v1"},
    "record_status": {"enum": ["evidence", "example"]},
    "scope": {"const": "product-validation"},
    "task": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,31}$"},
    "kind": {
      "enum": [
        "build",
        "unit",
        "protocol",
        "integration",
        "fault",
        "resource",
        "fuzz",
        "soak",
        "benchmark"
      ]
    },
    "result": {"enum": ["pass", "fail", "skip"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "source": {"$ref": "#/$defs/source"},
    "environment": {"$ref": "#/$defs/environment"},
    "build": {"$ref": "#/$defs/build"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "input_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 4096},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "counts": {"$ref": "#/$defs/counts"},
    "metrics": {
      "type": "array",
      "items": {"$ref": "#/$defs/metric"}
    },
    "reference_analysis": {"$ref": "#/$defs/referenceAnalysis"},
    "defects": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "pass"}}},
      "then": {
        "properties": {
          "counts": {"properties": {"failed": {"const": 0}}}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "fail"}}},
      "then": {"properties": {"defects": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"result": {"const": "skip"}}},
      "then": {"properties": {"limitations": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"kind": {"enum": ["fuzz", "soak", "benchmark"]}}},
      "then": {"required": ["metrics"], "properties": {"metrics": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!\\.\\.(?:/|$))(?!.*(?:/\\.\\.(?:/|$))).+$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 64},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty", "manifest_sha256"],
      "properties": {
        "revision": {"type": ["string", "null"], "minLength": 7, "maxLength": 64},
        "dirty": {"type": "boolean"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "manifest": {"$ref": "#/$defs/artifact"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_path", "snapshot_sha256"],
      "properties": {
        "snapshot_path": {"type": "string", "const": ".harness/reviews/environment.json"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "namedVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "build_type",
        "compiler",
        "dependencies",
        "capability_manifest",
        "instrumentation"
      ],
      "properties": {
        "preset": {
          "enum": ["dev", "release", "release-minimal", "asan", "ubsan", "coverage", "fuzz"]
        },
        "build_type": {"enum": ["Debug", "Release", "RelWithDebInfo"]},
        "compiler": {"$ref": "#/$defs/namedVersion"},
        "dependencies": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/namedVersion"}
        },
        "capability_manifest": {"$ref": "#/$defs/artifact"},
        "instrumentation": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["profiling", "asan", "ubsan", "coverage", "libfuzzer"]}
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "exit_code",
        "expected_exit_codes",
        "duration_ms",
        "stdout",
        "stderr"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "maxLength": 4096}
        },
        "cwd": {"type": "string", "const": "."},
        "exit_code": {"type": "integer"},
        "expected_exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer"}
        },
        "duration_ms": {"type": "integer", "minimum": 0},
        "stdout": {"$ref": "#/$defs/artifact"},
        "stderr": {"$ref": "#/$defs/artifact"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "executed", "passed", "failed", "skipped"],
      "properties": {
        "planned": {"type": "integer", "minimum": 0},
        "executed": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"type": "number"}
        },
        "samples_artifact": {"$ref": "#/$defs/artifact"},
        "p50": {"type": "number"},
        "p95": {"type": "number"},
        "p99": {"type": "number"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "value": {"type": "number"}
      },
      "oneOf": [
        {"required": ["samples"]},
        {"required": ["samples_artifact"]}
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "upstream", "revision", "license", "copied_code"],
      "properties": {
        "path": {"type": "string", "pattern": "^references/.+", "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"},
        "upstream": {"type": "string", "minLength": 1, "maxLength": 512},
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "license": {"type": "string", "minLength": 1, "maxLength": 128},
        "copied_code": {"type": "boolean"}
      }
    },
    "referenceAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background_reviewed", "records", "details"],
      "properties": {
        "background_reviewed": {"const": true},
        "records": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^references/.+", "maxLength": 4096}
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference"}
        }
      }
    }
  }
}
